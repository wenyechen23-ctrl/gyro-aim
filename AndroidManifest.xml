<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.gyro">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:label="GyroAim">
        <activity android:name=".GyroMain" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".GyroService" android:foregroundServiceType="dataSync" android:exported="false"/>
    </application>
</manifest>